# Public URL of the backend, WITHOUT /v1 and without trailing slash. Used for REST and socket.io.
# It is baked into the bundle at BUILD time, so changing it requires a redeploy.
#   Local dev: leave empty, Vite proxies /v1 and /socket.io to the API (see vite.config.ts)
#   Railway:   https://<your-backend>.up.railway.app   (or ${{Backend.RAILWAY_PUBLIC_DOMAIN}} prefixed with https://)
VITE_API_URL=

# Local dev only: where the Vite proxy forwards API calls and the dev server port
API_TARGET=http://localhost:4000
PORT=5174
