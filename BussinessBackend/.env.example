# ---------- App
# Railway injects PORT automatically; locally the API listens on 4000
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
# Railway: https://<your-frontend>.up.railway.app
CORS_ORIGIN=http://localhost:5174

# ---------- MongoDB (Atlas or any MongoDB 6+)
# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/business-simulator?retryWrites=true&w=majority
# Local dev: npm run dev:mongo -> mongodb://127.0.0.1:27018/business-simulator
MONGO_URI=mongodb://127.0.0.1:27018/business-simulator

# ---------- Redis (BullMQ: cycle deadlines)
# Railway Redis: set REDIS_URL=${{Redis.REDIS_URL}} (takes precedence over the REDIS_* values below)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
# 0 = resolve IPv4 and IPv6 (required for Railway's IPv6 private network)
REDIS_FAMILY=0

# ---------- Auth
# Use a long random value in production: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
PLAYER_TOKEN_TTL_HOURS=48

# ---------- Logs
LOG_LEVEL=info
# Optional Grafana Loki endpoint (requires adding the pino-loki package)
LOKI_URL=
