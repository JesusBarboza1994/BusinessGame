{
  "name": "bussiness-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Business Simulator API (NestJS + MongoDB + BullMQ)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "ts-node -r tsconfig-paths/register scripts/calibrate.ts",
    "dev:mongo": "ts-node --transpile-only scripts/dev-mongo.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "ioredis": "^6.0.0",
    "mongoose": "^8.24.5",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
